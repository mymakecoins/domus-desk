  "cards": [
    {
      "dot": "cyan",
      "title": "Quem Fala com Quem?",
      "items": [
        "Solicitantes via Self-Service falam com Chamados, Base de Conhecimento e Status de Serviços.",
        "Analistas no Watchtower consomem Chamados, Tarefas pendentes e Alertas em tempo real.",
        "Módulo de Chamados aciona o Motor de Workflows, solicita RFCs para Mudanças e escala Problemas."
      ]
    },
    {
      "dot": "emerald",
      "title": "Quem Depende de Quem?",
      "items": [
        "Gestão de Mudanças depende dos Itens de Configuração do CMDB para matriz de risco e aprovação CAB.",
        "Gestão de Ativos alimenta o CMDB e depende do módulo de Contratos para controle de garantias.",
        "Status dos Serviços depende das Janelas de Manutenção aprovadas em Mudanças e dos Morning Checks."
      ]
    },
    {
      "dot": "violet",
      "title": "Serviços Transversais (IA & Automação)",
      "items": [
        "Motor de Workflows reage a 138+ gatilhos de Chamados, Formulários e Mudanças para executar ações.",
        "Provedor de IA (BYOK) atua como assistente transversal para Chamados (respostas), Problemas (RCA) e KB (vetorial)."
      ]
    }
